{
    "compilerOptions": {
        "target": "ES2024",
        "module": "node20",
        "moduleResolution": "node16",
        "types": ["node"],
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "noImplicitAny": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
